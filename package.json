{
  "name": "lilith_apis",
  "version": "1.1.0",
  "description": "Apis for Lilith",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "env NODE_ENV=prod nest start",
    "start:watch": "env NODE_ENV=prod nest start --watch",
    "start:dev": "env NODE_ENV=dev nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "env NODE_ENV=test jest --config ./jest.json --coverage --no-cache",
    "test:watch": "env NODE_ENV=test jest --config ./jest.json --watch --coverage --no-cache",
    "test:e2e": "env NODE_ENV=test jest --config ./jest-e2e.json",
    "eros": "eros_gql",
    "link:sunny": "npm link @happykiller/sunny-apis",
    "up:sunny": "npm install @happykiller/sunny-apis@latest --force"
  },
  "dependencies": {
    "@apollo/server": "^4.12.1",
    "@happykiller/sunny-apis": "^0.7.0",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.2",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.4.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "eros_gql": "^1.2.8",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.5",
    "mongoose": "^8.15.1",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.2",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
